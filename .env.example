# ---- Required ------------------------------------------------------------
# One Etherscan V2 key covers every supported chain (Ethereum, Base, Celo, BSC).
# Free at https://etherscan.io/apis — endpoint: https://api.etherscan.io/v2/api?chainid=<id>
ETHERSCAN_API_KEY=

# ---- Optional: verdict cache (README §8.2) -------------------------------
# Any Upstash-style REST KV. Vercel KV sets the KV_* pair for you.
# Without these the cache still works, but only inside one warm instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional: AI rephrase layer (Phase 8) -------------------------------
# Set NONE of these and the tool is fully functional — the rules answer alone.
# Tried in this order; the first one configured wins.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama, e.g. http://localhost:11434
OLLAMA_URL=

# Model overrides (optional). Defaults were verified live on 2026-09-08:
#   Groq   -> qwen/qwen3.8-27b          (~0.6s; the Llama 3.3 line is retired)
#   Gemini -> gemini-flash-lite-latest  (~1.1s; 3.x flash models truncate mid-JSON)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OLLAMA_MODEL=llama3.2
